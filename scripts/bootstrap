#!/bin/sh
# Turn an empty Linux isolation host into a running execenv daemon. This
# is not an execenv subcommand. It does not pull containers and does not
# occupy grants. Re-running is safe: an existing token and TLS material stay.
#
#   scripts/bootstrap --artifact-dir ./images/default --execenv ./execenv
#   scripts/bootstrap --release https://example.invalid/execenv/v1.0.0
#
# Missing isolation device fails closed. There is no container fallback.
set -eu

DEVICE=/dev/kvm
PREFIX=/usr/local
SYSCONF=/etc/execenv
STATE=/var/lib/execenv
LISTEN=0.0.0.0:8443
SLOTS=8
ARTIFACT_DIR=
RELEASE=
EXECENV_BIN=
NO_START=0
NO_FETCH=0
INSECURE=0
# Pinned runtime/supervisor release used only when those binaries are absent.
RUNTIME_VERSION=v1.10.1

usage() {
	printf '%s\n' \
		"usage: scripts/bootstrap --artifact-dir DIR --execenv LINUX_EXECENV" \
		"       scripts/bootstrap --release URL [--execenv LINUX_EXECENV]" \
		"  --device --prefix --sysconf --state --listen --slots" \
		"  --no-start --no-fetch --insecure" \
		"  Fetches only install artifacts (kernel, rootfs, catalog, binaries)." \
		"  Does not pull containers. Does not print the token or catalog hash." >&2
	exit 2
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

json_field() {
	# $1 file $2 key — values are tokens/paths/hashes with no spaces.
	sed -n "s/.*\"$2\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -n 1
}

while [ $# -gt 0 ]; do
	case $1 in
	--device) DEVICE=${2:-}; shift 2 ;;
	--prefix) PREFIX=${2:-}; shift 2 ;;
	--sysconf) SYSCONF=${2:-}; shift 2 ;;
	--state) STATE=${2:-}; shift 2 ;;
	--listen) LISTEN=${2:-}; shift 2 ;;
	--slots) SLOTS=${2:-}; shift 2 ;;
	--artifact-dir) ARTIFACT_DIR=${2:-}; shift 2 ;;
	--release) RELEASE=${2:-}; shift 2 ;;
	--execenv) EXECENV_BIN=${2:-}; shift 2 ;;
	--no-start) NO_START=1; shift ;;
	--no-fetch) NO_FETCH=1; shift ;;
	--insecure) INSECURE=1; shift ;;
	-h | --help) usage ;;
	*) usage ;;
	esac
done

[ -n "$ARTIFACT_DIR" ] && [ -n "$RELEASE" ] && die "--artifact-dir and --release are mutually exclusive"
[ -n "$ARTIFACT_DIR" ] || [ -n "$RELEASE" ] || die "need --artifact-dir or --release (baked catalog; this host does not pull containers)"

# Fail closed before any download. A missing device is not a container job.
if [ ! -e "$DEVICE" ] || [ ! -r "$DEVICE" ] || [ ! -w "$DEVICE" ]; then
	die "isolation device $DEVICE is missing or not usable; this host cannot occupy grants (no container fallback)"
fi

BINDIR=$PREFIX/bin
IMAGEDIR=$STATE/images/default
WORKDIR=$STATE/work
CONFIG=$SYSCONF/host.json
# /etc/execenv → /etc/systemd/system
UNITDIR=$(dirname "$SYSCONF")/systemd/system

mkdir -p "$BINDIR" "$IMAGEDIR" "$WORKDIR" "$SYSCONF" "$UNITDIR"

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || die "bootstrap requires $1"
}

fetch() {
	url=$1
	dest=$2
	need_cmd curl
	curl -fsSL "$url" -o "$dest"
}

install_file() {
	src=$1
	dest=$2
	mode=$3
	if [ "$src" -ef "$dest" ]; then
		chmod "$mode" "$dest"
		return
	fi
	cp "$src" "$dest"
	chmod "$mode" "$dest"
}

# --- execenv binary ---
if [ -z "$EXECENV_BIN" ] && [ -n "$ARTIFACT_DIR" ] && [ -f "$ARTIFACT_DIR/execenv" ]; then
	EXECENV_BIN=$ARTIFACT_DIR/execenv
fi
if [ -z "$EXECENV_BIN" ] && [ -n "$RELEASE" ]; then
	need_cmd curl
	fetch "$RELEASE/execenv" "$BINDIR/execenv.download"
	EXECENV_BIN=$BINDIR/execenv.download
fi
[ -n "$EXECENV_BIN" ] && [ -f "$EXECENV_BIN" ] || die "need --execenv or execenv in --artifact-dir / --release"
install_file "$EXECENV_BIN" "$BINDIR/execenv" 755
rm -f "$BINDIR/execenv.download"

# --- runtime + supervisor (verify each, fetch both if either is missing) ---
RUNTIME_NAME=firecracker
SUPERVISOR_NAME=jailer

have_runtime() { [ -x "$BINDIR/$RUNTIME_NAME" ] || command -v "$RUNTIME_NAME" >/dev/null 2>&1; }
have_supervisor() { [ -x "$BINDIR/$SUPERVISOR_NAME" ] || command -v "$SUPERVISOR_NAME" >/dev/null 2>&1; }

if have_runtime; then
	[ -x "$BINDIR/$RUNTIME_NAME" ] || install_file "$(command -v "$RUNTIME_NAME")" "$BINDIR/$RUNTIME_NAME" 755
fi
if have_supervisor; then
	[ -x "$BINDIR/$SUPERVISOR_NAME" ] || install_file "$(command -v "$SUPERVISOR_NAME")" "$BINDIR/$SUPERVISOR_NAME" 755
fi
if ! have_runtime || ! have_supervisor; then
	if [ "$NO_FETCH" -eq 1 ]; then
		die "runtime ($RUNTIME_NAME) and supervisor ($SUPERVISOR_NAME) binaries are required"
	fi
	need_cmd curl
	need_cmd tar
	arch=$(uname -m)
	case $arch in
	x86_64 | aarch64) ;;
	*) die "unsupported machine $arch" ;;
	esac
	tgz=$STATE/runtime.tgz
	fetch "https://github.com/firecracker-microvm/firecracker/releases/download/${RUNTIME_VERSION}/firecracker-${RUNTIME_VERSION}-${arch}.tgz" "$tgz"
	tar -xzf "$tgz" -C "$STATE"
	src=$(find "$STATE" -type f -name "${RUNTIME_NAME}-${RUNTIME_VERSION}-${arch}" | head -n 1)
	[ -n "$src" ] || die "runtime binary not in fetched archive"
	install_file "$src" "$BINDIR/$RUNTIME_NAME" 755
	jsrc=$(find "$STATE" -type f -name "${SUPERVISOR_NAME}-${RUNTIME_VERSION}-${arch}" | head -n 1)
	[ -n "$jsrc" ] || die "supervisor binary not in fetched archive"
	install_file "$jsrc" "$BINDIR/$SUPERVISOR_NAME" 755
	rm -f "$tgz"
fi
[ -x "$BINDIR/$RUNTIME_NAME" ] || die "runtime binary $RUNTIME_NAME is missing"
[ -x "$BINDIR/$SUPERVISOR_NAME" ] || die "supervisor binary $SUPERVISOR_NAME is missing"

# --- catalog disk (already baked; never a container registry) ---
if [ -n "$ARTIFACT_DIR" ]; then
	[ -f "$ARTIFACT_DIR/vmlinux" ] || die "artifact-dir missing vmlinux"
	[ -f "$ARTIFACT_DIR/rootfs.ext4" ] || die "artifact-dir missing rootfs.ext4"
	[ -f "$ARTIFACT_DIR/catalog.json" ] || die "artifact-dir missing catalog.json"
	install_file "$ARTIFACT_DIR/vmlinux" "$IMAGEDIR/vmlinux" 644
	install_file "$ARTIFACT_DIR/rootfs.ext4" "$IMAGEDIR/rootfs.ext4" 644
	install_file "$ARTIFACT_DIR/catalog.json" "$IMAGEDIR/catalog.json" 644
else
	need_cmd curl
	fetch "$RELEASE/vmlinux" "$IMAGEDIR/vmlinux"
	fetch "$RELEASE/rootfs.ext4" "$IMAGEDIR/rootfs.ext4"
	fetch "$RELEASE/catalog.json" "$IMAGEDIR/catalog.json"
	chmod 644 "$IMAGEDIR/vmlinux" "$IMAGEDIR/rootfs.ext4" "$IMAGEDIR/catalog.json"
fi

if command -v sha256sum >/dev/null 2>&1; then
	GOT=$(cat "$IMAGEDIR/vmlinux" "$IMAGEDIR/rootfs.ext4" | sha256sum | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
	GOT=$(cat "$IMAGEDIR/vmlinux" "$IMAGEDIR/rootfs.ext4" | shasum -a 256 | awk '{print $1}')
else
	die "bootstrap requires sha256sum"
fi
WANT=$(json_field "$IMAGEDIR/catalog.json" hash)
[ -n "$WANT" ] || die "catalog.json has no hash"
[ "$GOT" = "$WANT" ] || die "catalog hash does not match kernel+rootfs on disk"
IMAGE_ID=$(json_field "$IMAGEDIR/catalog.json" id)
[ -n "$IMAGE_ID" ] || IMAGE_ID=default

# --- token + TLS: keep existing, never print ---
TOKEN=
if [ -f "$CONFIG" ]; then
	TOKEN=$(json_field "$CONFIG" token)
fi
if [ -z "$TOKEN" ]; then
	TOKEN=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
	[ -n "$TOKEN" ] || die "could not generate token"
fi

SECURITY=tls
TLS_CERT=$SYSCONF/tls.crt
TLS_KEY=$SYSCONF/tls.key
if [ "$INSECURE" -eq 1 ]; then
	SECURITY=insecure_local
	TLS_CERT=
	TLS_KEY=
else
	if [ ! -f "$TLS_CERT" ] || [ ! -f "$TLS_KEY" ]; then
		need_cmd openssl
		openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
			-keyout "$TLS_KEY" -out "$TLS_CERT" \
			-subj "/CN=execenv" >/dev/null 2>&1
		chmod 600 "$TLS_KEY"
		chmod 644 "$TLS_CERT"
	fi
fi

# host.json is the only place the token and digest are stored.
{
	printf '{\n'
	printf '  "listen": "%s",\n' "$LISTEN"
	printf '  "token": "%s",\n' "$TOKEN"
	printf '  "security": "%s",\n' "$SECURITY"
	printf '  "adapter": "isolated",\n'
	if [ "$SECURITY" = tls ]; then
		printf '  "tls_cert": "%s",\n' "$TLS_CERT"
		printf '  "tls_key": "%s",\n' "$TLS_KEY"
	fi
	printf '  "work_dir": "%s",\n' "$WORKDIR"
	printf '  "device": "%s",\n' "$DEVICE"
	printf '  "runtime": "%s",\n' "$BINDIR/$RUNTIME_NAME"
	printf '  "supervisor": "%s",\n' "$BINDIR/$SUPERVISOR_NAME"
	printf '  "images": [\n'
	printf '    {\n'
	printf '      "id": "%s",\n' "$IMAGE_ID"
	printf '      "kernel": "%s",\n' "$IMAGEDIR/vmlinux"
	printf '      "rootfs": "%s",\n' "$IMAGEDIR/rootfs.ext4"
	printf '      "hash": "%s"\n' "$WANT"
	printf '    }\n'
	printf '  ],\n'
	printf '  "slots": %s,\n' "$SLOTS"
	printf '  "network": "none",\n'
	printf '  "grace": "30s"\n'
	printf '}\n'
} >"$CONFIG"
chmod 600 "$CONFIG"

UNIT=$UNITDIR/execenv.service
{
	printf '%s\n' \
		"[Unit]" \
		"Description=execenv host" \
		"After=network-online.target" \
		"Wants=network-online.target" \
		"" \
		"[Service]" \
		"Type=simple" \
		"ExecStart=$BINDIR/execenv -config $CONFIG" \
		"Restart=on-failure" \
		"NoNewPrivileges=true" \
		"" \
		"[Install]" \
		"WantedBy=multi-user.target"
} >"$UNIT"

if [ "$NO_START" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
	systemctl daemon-reload
	systemctl enable --now execenv.service
fi

# Operator stdout: paths only. Token and hash stay in $CONFIG.
printf '%s\n' \
	"execenv installed" \
	"config=$CONFIG" \
	"image=$IMAGE_ID" \
	"device=ok" \
	"token=written to config" \
	"hash=written to config" \
	"ready=device+runtime+supervisor+catalog (start the unit, then Ready)"
